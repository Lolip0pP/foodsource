# Yandex Cloud credentials
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
# Set only when Search API uses a separate key
YANDEX_SEARCH_API_KEY=

# Optional service settings
YANDEX_MODEL=yandexgpt-5-lite/latest
LLM_POLL_INTERVAL=3
LLM_TIMEOUT=600
SEARCH_TIMEOUT=300
MAX_PARALLEL_LLM=5

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
